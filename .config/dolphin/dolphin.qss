/* macOS Finder Style Toolbar for Dolphin */

QToolBar {
    spacing: 6px;
    padding: 6px 10px;
    border: none;
    background: transparent;
}

/* Toolbar Buttons (Back, Forward, View Modes, Preview, etc.) */
QToolBar QToolButton {
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 7px;
    padding: 4px 7px;
    background-color: rgba(255, 255, 255, 0.05);
    margin: 1px;
}

QToolBar QToolButton:hover {
    border: 1px solid rgba(255, 255, 255, 0.38);
    background-color: rgba(255, 255, 255, 0.14);
}

QToolBar QToolButton:pressed {
    border: 1px solid rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 255, 255, 0.22);
}

QToolBar QToolButton:checked {
    border: 1px solid rgba(255, 255, 255, 0.45);
    background-color: rgba(255, 255, 255, 0.18);
}

/* URL Navigator & Search Bar */
QToolBar KUrlNavigator,
QToolBar QLineEdit {
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 7px;
    padding: 3px 8px;
    background-color: rgba(0, 0, 0, 0.25);
}

QToolBar KUrlNavigator:hover,
QToolBar QLineEdit:hover,
QToolBar QLineEdit:focus {
    border: 1px solid rgba(255, 255, 255, 0.4);
    background-color: rgba(0, 0, 0, 0.35);
}

/* Hide arrow dropdown indicator on toolbar buttons if any */
QToolBar QToolButton::menu-indicator {
    image: none;
}
